# ── Supabase (Sendkar's own account/project) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings > API Keys > service_role (or "secret" on newer projects). Full
# privileges, bypasses RLS — server-only, never expose to the browser.
SUPABASE_SECRET_KEY=

# ── Meta / WhatsApp ────────────────────────────────────────────────────────────
# From your Meta App's Basic Settings — used to verify webhook signatures
# (X-Hub-Signature-256), shared across every workspace's WhatsApp connection.
META_APP_SECRET=
# Any string you make up — enter the SAME value in Meta's webhook config
# (App Dashboard > WhatsApp > Configuration > Verify Token).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Embedded Signup (self-serve WABA connect, replaces manual token entry) ──
# From your Meta App's Basic Settings — the App ID (public, safe client-side).
NEXT_PUBLIC_META_APP_ID=
# App Dashboard > WhatsApp > Configuration > Embedded Signup > create a
# configuration, copy its ID. Works for your own app's test users without
# review; anyone else needs Meta App Review approval for
# whatsapp_business_management + whatsapp_business_messaging first — that's
# a manual process on Meta's side, budget real days/weeks for it.
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=

# ── Shopify (one Partner app, every workspace installs it into their own store) ─
# From partners.shopify.com — create an app, copy its Client ID/Secret.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────────
# resend.com/api-keys. The sender domain (hello@sendkar.shop) must be
# verified under resend.com/domains first, or sends fail with a clear error
# and the app falls back to showing the invite link instead of emailing it.
RESEND_API_KEY=

# ── Error monitoring (Sentry) ────────────────────────────────────────────────────
# sentry.io > create a Next.js project > copy its DSN. Leave blank to skip —
# every Sentry.init() call in this repo is gated on this var being set.
NEXT_PUBLIC_SENTRY_DSN=

# ── AI campaign image generation (Google Gemini) ────────────────────────────────
# aistudio.google.com/apikey. Feature is hidden in the UI (Templates page)
# until this is set — no fallback provider, campaign image generation just
# stays off on a deployment without it.
GEMINI_API_KEY=

# ── Cron ───────────────────────────────────────────────────────────────────────
# Any random string. Vercel automatically sends this as a Bearer token to
# Cron-invoked routes when this env var is set — no extra config needed on
# Vercel's side, just set the same value here and in the Vercel dashboard.
CRON_SECRET=

# ── Password reset (WhatsApp OTP) ───────────────────────────────────────────────
# The one workspace whose WhatsApp connection sends the platform's own
# password-reset OTP (see lib/passwordReset.ts) — not a per-workspace secret,
# the workspace id (uuid) of whichever connected number should send these.
SYSTEM_SENDER_WORKSPACE_ID=

# ── AI inbox features (Anthropic Claude) — reply drafting, auto-reply, template/
# campaign-strategy generation, message classification (lib/ai.ts) ─────────────
# console.anthropic.com/settings/keys. Every feature here degrades to "off"
# without this set, never a hard failure.
ANTHROPIC_API_KEY=

# ── Billing (Dodo Payments) — Sendkar's own subscription checkout, separate from
# the Razorpay/PayU keys workspaces enter under Settings > Payments for their
# OWN customer-facing payment links ─────────────────────────────────────────────
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
# One Dodo product id per paid plan — dashboard.dodopayments.com > Products.
DODO_PRODUCT_STARTER=
DODO_PRODUCT_GROWTH=
DODO_PRODUCT_SCALE=

# ── Web Push (inbox notifications) ──────────────────────────────────────────────
# Generate a pair with `npx web-push generate-vapid-keys` — not tied to any
# external account, just a keypair this deployment signs push messages with.
# Public key is safe client-side by design (NEXT_PUBLIC_); the private key
# is not. Feature is hidden until both are set.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Analytics (Google Analytics) ────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
